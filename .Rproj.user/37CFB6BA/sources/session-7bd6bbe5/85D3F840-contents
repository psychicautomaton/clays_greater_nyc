```{r}
clay_percs <- st_read(dbp,
                      layer = "rating_Clay_DCD_AL") %>% 
  select(musym, Clay_DCD_AL) %>%
  distinct()

musym <- st_read(dbp,
                      layer = "mapunit")  %>% 
  select(musym, muname, interpfocus) %>% distinct()

mupoly <- st_read(dbp,
                      layer = "mupolygon") %>%
  select(musym, shape) %>% distinct()

```
```{r}
df <- left_join(musym,
                clay_percs,
                by="musym") %>% 
  distinct()

df <- left_join(df,
                mupoly,
                by = "musym") %>%
  distinct() %>%
  filter(Clay_DCD_AL > 15)

df <- sf::st_as_sf(df)

df <- df %>%
  mutate(centroids = st_centroid(shape))
```

```{r}
pal <- colorNumeric(
  palette = "magma",
  domain = df$Clay_DCD_AL,
  reverse = TRUE)
```


